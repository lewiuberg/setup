{# Generated by macsetup. Re-run the wizard to regenerate. #}
# Enable Powerlevel10k instant prompt. Keep this at the very top.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ------------------------------------------------------------------------------
# Architecture-aware Homebrew shellenv
# ------------------------------------------------------------------------------
if [ "$(uname -p)" = "i386" ]; then
    eval "$(/usr/local/bin/brew shellenv)"
    alias brew="/usr/local/bin/brew"
else
    eval "$(/opt/homebrew/bin/brew shellenv)"
    alias brew="/opt/homebrew/bin/brew"
fi

# ------------------------------------------------------------------------------
# Oh My Zsh
# ------------------------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git gh wd docker docker-compose vscode {{ extra_plugins | join(' ') }})
source $ZSH/oh-my-zsh.sh
{% if include_mise %}
# ------------------------------------------------------------------------------
# mise (polyglot runtime manager)
# ------------------------------------------------------------------------------
eval "$(mise activate zsh)"
{% endif %}
# ------------------------------------------------------------------------------
# zsh-syntax-highlighting
# ------------------------------------------------------------------------------
source $ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# ------------------------------------------------------------------------------
# zsh-autosuggestions
# ------------------------------------------------------------------------------
source $ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
{% if include_poetry %}
# ------------------------------------------------------------------------------
# Poetry (legacy projects)
# ------------------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"
{% endif %}{% if include_uv %}
# ------------------------------------------------------------------------------
# uv (Python project manager)
# ------------------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"
{% endif %}
# ------------------------------------------------------------------------------
# Aliases
# ------------------------------------------------------------------------------
alias azsh="arch -arm64 zsh"             # run zsh in ARM mode
alias izsh="arch -x86_64 zsh"            # run zsh in Intel/Rosetta mode
alias aliases='grep "^alias" ~/.zshrc | sed "s/alias //g"'
alias lss="ls -alhS"                      # list files by size
alias lsla="ls -la"                       # list all files including hidden
alias ch='history | grep "git commit"'
alias pih='history | grep "pip install"'
alias poh='history | grep "poetry add"'
alias hg="history | grep"
alias ppip="python3 -m pip"
alias show='defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder'
alias hide='defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder'

# ------------------------------------------------------------------------------
# Powerlevel10k config
# ------------------------------------------------------------------------------
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

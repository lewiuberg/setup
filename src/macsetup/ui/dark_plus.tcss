/* VS Code Dark+ palette
   bg #1e1e1e, panel #252526, fg #d4d4d4, accent #007acc
   teal #4ec9b0, orange #ce9178, muted #6a737d */

Screen {
    background: #1e1e1e;
    color: #d4d4d4;
}

Header {
    background: #252526;
    color: #d4d4d4;
}

Footer {
    background: #007acc;
    color: #ffffff;
}

#main {
    height: 1fr;
}

#sections-pane {
    width: 42;
    background: #252526;
    border-right: solid #3c3c3c;
    padding: 0 1;
}

#pane-title-sections {
    color: #6a737d;
    text-style: bold;
    padding: 1 1 0 1;
}

#section-list {
    background: #252526;
    height: 1fr;
}

#section-list > ListItem {
    background: #252526;
    padding: 0 1;
}

#section-list > ListItem.--highlight {
    background: #094771;
    color: #ffffff;
}

#detail-pane {
    padding: 1 2;
    height: 1fr;
}

#detail-title {
    color: #d4d4d4;
    padding-bottom: 1;
}

#detail-desc {
    color: #6a737d;
    padding-bottom: 1;
}

SelectionList {
    background: #1e1e1e;
    color: #d4d4d4;
    height: auto;
    max-height: 40;
}

SelectionList > .selection-list--button-selected {
    color: #4ec9b0;
}

.hidden {
    display: none;
}

#exec-progress {
    color: #d4d4d4;
    background: #252526;
    padding: 0 1;
    height: 1;
    margin-bottom: 1;
}

#exec-log {
    height: 1fr;
    background: #1e1e1e;
    color: #d4d4d4;
    border: solid #3c3c3c;
    padding: 0 1;
}
